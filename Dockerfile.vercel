FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS go-builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /app/server
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server ./
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags="-s -w" -o /app/ledger-web ./cmd/ledger-web

FROM debian:bookworm-slim AS runner
WORKDIR /app
ENV GIN_MODE=release
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates python3 python3-pip \
  && rm -rf /var/lib/apt/lists/* \
  && pip3 install --no-cache-dir --break-system-packages beancount==3.2.3 \
  && groupadd --system ledger \
  && useradd --system --gid ledger --create-home --shell /usr/sbin/nologin ledger
COPY --from=go-builder /app/ledger-web ./ledger-web
COPY examples ./examples
USER ledger
EXPOSE 3000
CMD ["./ledger-web"]
