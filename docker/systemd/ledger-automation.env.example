# /etc/ledger-automation/env (root:ledger-automation 0640). No secrets here:
# the model key, the Bark key and the SSH deploy key are separate files.
# SSH over port 443: mibook cannot reach github.com on port 22.
LEDGER_AUTOMATION_REPO=ssh://git@ssh.github.com:443/qiaoborui/beancount-ledger.git
LEDGER_AUTOMATION_BRANCH=main
LEDGER_AUTOMATION_RUNS_BRANCH=automation-runs
# The 账本助手 memory shared with the phone: write (default), read or off.
#LEDGER_AUTOMATION_MEMORY=write
#LEDGER_AUTOMATION_MEMORY_BRANCH=agent-memory
LEDGER_AUTOMATION_TIMEZONE=Asia/Singapore
# The magpie gateway on the same host; nothing leaves the machine. Any
# OpenAI-compatible (openai-completions, openai-responses) or Anthropic
# (anthropic-messages) endpoint works.
LEDGER_AUTOMATION_MODEL_API=openai-completions
LEDGER_AUTOMATION_MODEL_BASE_URL=http://127.0.0.1:3425/v1
LEDGER_AUTOMATION_MODEL=auto/deepseek-flash
LEDGER_AUTOMATION_THINKING=low
# The model's limits come from the endpoint's /v1/models (magpie lists
# context_length and max_output_tokens). Set these only to override it; with
# neither, the Agent assumes 8192 tokens per reply, which a reasoning model
# can spend entirely on thinking ("输出达到长度上限").
#LEDGER_AUTOMATION_CONTEXT_WINDOW=
#LEDGER_AUTOMATION_MAX_OUTPUT_TOKENS=
# Public Bark server; set bark-encryption-key to keep it from reading pushes.
LEDGER_AUTOMATION_BARK_SERVER=https://api.day.app
# Optional push look: defaults are group 账本定时任务, the App icon, birdsong.
#LEDGER_AUTOMATION_BARK_GROUP=
#LEDGER_AUTOMATION_BARK_ICON=
#LEDGER_AUTOMATION_BARK_SOUND=
# 1 hides amounts and payees from pushes.
LEDGER_AUTOMATION_GENERIC_NOTIFICATIONS=0
LEDGER_AUTOMATION_KEEP_RUNS=200
# Optional: a validator for the Agent's bean_check tool, e.g. /usr/local/bin/bean-check
#LEDGER_AUTOMATION_BEAN_CHECK=
