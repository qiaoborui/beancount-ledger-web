# /etc/ledger-automation/env (root:ledger-automation 0640). No secrets here:
# the model key, the Bark key and the SSH deploy key are separate files.
LEDGER_AUTOMATION_REPO=git@github.com:qiaoborui/<private-ledger>.git
LEDGER_AUTOMATION_BRANCH=main
LEDGER_AUTOMATION_RUNS_BRANCH=automation-runs
LEDGER_AUTOMATION_TIMEZONE=Asia/Singapore
# The freellmapi gateway on the same host; nothing leaves the machine.
LEDGER_AUTOMATION_MODEL_API=openai-completions
LEDGER_AUTOMATION_MODEL_BASE_URL=http://127.0.0.1:3333/v1
LEDGER_AUTOMATION_MODEL=<model id from the gateway's /v1/models>
LEDGER_AUTOMATION_THINKING=low
# Public Bark server; set bark-encryption-key to keep it from reading pushes.
LEDGER_AUTOMATION_BARK_SERVER=https://api.day.app
# 1 hides amounts and payees from pushes.
LEDGER_AUTOMATION_GENERIC_NOTIFICATIONS=0
LEDGER_AUTOMATION_KEEP_RUNS=200
# Optional: a validator for the Agent's bean_check tool, e.g. /usr/local/bin/bean-check
#LEDGER_AUTOMATION_BEAN_CHECK=
