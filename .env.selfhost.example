# Copy this file to .env.selfhost. It contains no usable secrets.
# Empty or clean local checkout used only by the indexer. It is never mounted
# into the API container. Must match the owner on the Docker host (`id -u`, `id -g`).
LEDGER_CHECKOUT_HOST_PATH=/absolute/path/to/ledger-checkout
LEDGER_UID=1000
LEDGER_GID=1000
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
SELFHOST_IMAGE_TAG=latest
AUTH_SECRET=replace-with-openssl-rand-base64-32
APP_PASSWORD=replace-with-a-long-login-password
# API token: fine-grained Contents read/write access to the private ledger repo.
LEDGER_GITHUB_OWNER=your-github-owner
LEDGER_GITHUB_REPO=your-private-ledger
LEDGER_GIT_BRANCH=main
LEDGER_GITHUB_TOKEN=replace-with-github-contents-read-write-token
# Indexer token: separate fine-grained Contents read-only token. The checkout
# is cloned/fetched by the indexer; this token is never supplied to the API.
LEDGER_GITHUB_INDEX_TOKEN=replace-with-github-contents-read-only-token
LEDGER_GIT_REMOTE_URL=https://github.com/your-github-owner/your-private-ledger.git

# Local-only HTTP is the safe default.
SELFHOST_HTTP_BIND_ADDRESS=127.0.0.1
SELFHOST_HTTP_PORT=8080
# HTTPS remains local until explicitly exposed for LAN use.
SELFHOST_HTTPS_BIND_ADDRESS=127.0.0.1
SELFHOST_HTTPS_PORT=8443

LEDGER_INDEX_INTERVAL_SECONDS=60
LEDGER_INDEX_RETRY_INITIAL_SECONDS=5
LEDGER_INDEX_RETRY_MAX_SECONDS=60
LEDGER_AUTH_DISABLED=false
# Use http only for an explicitly accepted, same-origin LAN deployment.
# It disables Secure cookies; do not configure CORS or WebAuthn in that mode.
LEDGER_AUTH_TRANSPORT=https
LEDGER_ENABLED_MODULES=importers
