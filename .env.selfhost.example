# Copy this file to .env.selfhost. It contains no usable secrets.
# Empty or clean local checkout used only by the indexer. It is never mounted
# into the API container. Must match the owner on the Docker host (`id -u`, `id -g`).
LEDGER_CHECKOUT_HOST_PATH=/absolute/path/to/ledger-checkout
LEDGER_UID=1000
LEDGER_GID=1000
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
SELFHOST_IMAGE_TAG=latest
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Internal identity shared only by the API and indexer containers. It lets the
# indexer retrieve its read-only token without receiving AUTH_SECRET.
INDEXER_IDENTITY_TOKEN=replace-with-openssl-rand-base64-32
# Internal shared secret for API ↔ Bub Agent calls. The Agent is not exposed by Caddy.
AGENT_SERVICE_TOKEN=replace-with-openssl-rand-base64-32
BUB_MODEL=openai:ledger-agent

# Local-only HTTP is the safe default.
SELFHOST_HTTP_BIND_ADDRESS=127.0.0.1
SELFHOST_HTTP_PORT=8080
# HTTPS remains local until explicitly exposed for LAN use.
SELFHOST_HTTPS_BIND_ADDRESS=127.0.0.1
SELFHOST_HTTPS_PORT=8443

LEDGER_AUTH_DISABLED=false
# Loopback HTTP is the default. Change this to https when enabling the explicit
# LAN TLS configuration from docs/self-hosted-compose.md.
LEDGER_AUTH_TRANSPORT=http
LEDGER_ENABLED_MODULES=importers

# GitHub owner/repository/branch, separate write and read-only tokens, the
# administrator password, AI provider/base URL/model/key, and indexer retry
# timings are entered in the browser installation page and stored in Postgres.
# The one-time installation code is printed only in the server container log:
# docker compose -f docker/docker-compose.selfhost.yml logs server
